{
  "name": "pharma-network-wastefacility",
  "version": "1.0.0",
  "client": {
    "organization": "WasteFacilityOrg",
    "connection": {
      "timeout": {
        "peer": {
          "endorser": "300"
        }
      }
    }
  },
  "organizations": {
    "WasteFacilityOrg": {
      "mspid": "WasteFacilityMSP",
      "peers": [
        "peer0.wastefacility.pharma.com"
      ],
      "certificateAuthorities": [
        "ca.pharma.com"
      ]
    }
  },
  "peers": {
    "peer0.wastefacility.pharma.com": {
      "url": "grpcs://localhost:10051",
      "tlsCACerts": {
        "path": "fabric-network/organizations/peerOrganizations/wastefacility.pharma.com/peers/peer0.wastefacility.pharma.com/tls/ca.crt"
      },
      "grpcOptions": {
        "ssl-target-name-override": "peer0.wastefacility.pharma.com",
        "hostnameOverride": "peer0.wastefacility.pharma.com"
      }
    }
  }
}
