{
  "name": "pharma-network-manufacturer",
  "version": "1.0.0",
  "client": {
    "organization": "ManufacturerOrg",
    "connection": {
      "timeout": {
        "peer": {
          "endorser": "300"
        }
      }
    }
  },
  "organizations": {
    "ManufacturerOrg": {
      "mspid": "ManufacturerMSP",
      "peers": [
        "peer0.manufacturer.pharma.com"
      ],
      "certificateAuthorities": [
        "ca.pharma.com"
      ]
    }
  },
  "peers": {
    "peer0.manufacturer.pharma.com": {
      "url": "grpcs://localhost:7051",
      "tlsCACerts": {
        "path": "fabric-network/organizations/peerOrganizations/manufacturer.pharma.com/peers/peer0.manufacturer.pharma.com/tls/ca.crt"
      },
      "grpcOptions": {
        "ssl-target-name-override": "peer0.manufacturer.pharma.com",
        "hostnameOverride": "peer0.manufacturer.pharma.com"
      }
    }
  },
  "certificateAuthorities": {
    "ca.pharma.com": {
      "url": "https://localhost:7054",
      "caName": "ca-pharma",
      "tlsCACerts": {
        "path": "fabric-network/organizations/fabric-ca/pharma/ca-cert.pem"
      },
      "httpOptions": {
        "verify": false
      }
    }
  }
}
